<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="My Wellness"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true">
        <!-- image_picker decodes the camera's own JPEG before it can downscale it to
             maxWidth/maxHeight — on a phone with a very high-megapixel sensor that source file
             can be tens of MB, and the intermediate bitmap has thrown OutOfMemoryError on some
             devices right at the hand-off from the camera app. A larger heap ceiling is the
             standard mitigation; it costs nothing when it is not needed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_local_notifications: re-schedules the reminder after a reboot. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- The ongoing, quick-action notification for an active workout — see
             lib/platform/workout_notification.dart. `specialUse` because there is no narrower
             foreground-service type for "keep a workout log notification interactive while the
             screen is locked"; `dataSync` and `mediaPlayback` would both misdescribe what this
             does. Never started except while a session is running and the Settings toggle for
             it is on — see WorkoutNotification.sync. -->
        <service
            android:name=".WorkoutNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live logging of an in-progress workout from its ongoing notification" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <!-- Workout-day reminder: a local notification on days that have a routine planned. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the reminder fire at the exact minute on Android 12+. Where it is not granted,
         scheduling silently falls back to an inexact alarm — the reminder still arrives, just
         not to the minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Re-arms the schedule after a restart, so a reboot does not silently end the reminder. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The rest timer buzzes at zero. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the screen on while a workout is running. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The workout quick-action notification, opt-in in Settings. Both are required from
         targetSdk 34 on — the typed permission alongside the plain one, and the service's own
         foregroundServiceType in <application> above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Meal photos, and nothing else. This is the only network the app makes: a request goes out
         only when the user has set up their own API key and taken a photo for it, straight to the
         provider they chose. No http client is even constructed unless the feature is available.

         Deliberately NOT android.permission.CAMERA. image_picker fires ACTION_IMAGE_CAPTURE at
         whatever camera app is installed and does not need it — but once CAMERA is *declared* in
         the merged manifest, Android starts requiring it to be granted before that intent will
         start, and the capture throws for a permission the app never asked the user for. Adding
         it looks obviously correct and breaks the feature. See test/android_config_test.dart. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
